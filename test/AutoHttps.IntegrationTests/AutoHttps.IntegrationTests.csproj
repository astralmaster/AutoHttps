<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- The .NET 9 and later SDK tests each target framework in parallel by default. Two copies of this
         suite at once compete for ports and for the CPU the TLS handshakes need, which is the same
         starvation the runner settings below exist to prevent within one copy. -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Each test here starts a Kestrel host and an ACME server. Letting xunit use every core, in
         three assemblies at once, starves the TLS handshakes the assertions depend on. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/AutoHttps/AutoHttps.csproj" />
  </ItemGroup>

</Project>
