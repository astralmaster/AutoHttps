<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>AutoHttps.Azure</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>AutoHttps.Azure</PackageId>
    <VersionPrefix>1.0.1</VersionPrefix>
    <Title>AutoHttps.Azure</Title>
    <Description>Azure DNS and Key Vault support for AutoHttps: dns-01 challenges through Azure DNS, and certificate and account key storage in Key Vault.</Description>
    <PackageTags>acme;letsencrypt;dns-01;azure;azure-dns;keyvault;certificate;store;autohttps</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.ResourceManager.Dns" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AutoHttps/AutoHttps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="AutoHttps.Azure.Tests" />
  </ItemGroup>

</Project>
