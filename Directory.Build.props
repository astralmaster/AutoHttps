<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Product>AutoHttps</Product>
    <Authors>George Andguladze</Authors>
    <Copyright>Copyright (c) George Andguladze</Copyright>
    <RepositoryUrl>https://github.com/astralmaster/AutoHttps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/astralmaster/AutoHttps</PackageProjectUrl>
    <VersionPrefix>1.8.0</VersionPrefix>
  </PropertyGroup>

  <!-- A .snupkg next to each .nupkg, so a debugger can step into the library from nuget.org's symbol
       server. ContinuousIntegrationBuild makes the paths in the PDB repository relative, which source
       link needs. Pass it on the command line when packing outside CI. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
