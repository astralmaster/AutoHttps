<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Product>AutoHttps</Product>
    <Authors>George Andguladze</Authors>
    <Copyright>Copyright (c) George Andguladze</Copyright>
    <RepositoryUrl>https://github.com/astralmaster/AutoHttps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/astralmaster/AutoHttps</PackageProjectUrl>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

</Project>
